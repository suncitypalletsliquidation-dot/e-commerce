# Base URL of the deployed site — used for canonical tags, Open Graph URLs,
# metadataBase, and the sitemap. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console HTML-tag verification (Settings -> Ownership verification -> HTML tag).
# Paste only the `content` value from the meta tag, not the whole tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (starts with G-).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
